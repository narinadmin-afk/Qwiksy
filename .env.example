# ============================================================
# เว็บแอปขายสินค้าดิจิทัล - Environment Variables (ตัวอย่าง)
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า ห้าม commit ไฟล์ .env จริง
# ============================================================

# ---- แอปพลิเคชัน ----
NODE_ENV=development
PORT=4000
# ที่อยู่ Frontend (สำหรับ CORS และ redirect หลัง login)
APP_URL=http://localhost:5173
# ที่อยู่ Backend (ใช้สร้าง OAuth callback URL)
API_URL=http://localhost:4000
# Origin ที่อนุญาตให้เรียก API (คั่นด้วย , )
CORS_ORIGINS=http://localhost:5173

# ---- ฐานข้อมูล MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=marketplace
DB_PASSWORD=change_me
DB_NAME=digital_marketplace
DB_CONNECTION_LIMIT=10

# ---- Session (ใส่ค่าสุ่มยาวๆ สำหรับ production) ----
SESSION_SECRET=change_me_to_a_long_random_string
# ตั้ง true เมื่อรันหลัง HTTPS เท่านั้น
COOKIE_SECURE=false
SESSION_TTL_DAYS=7

# ---- Google OAuth 2.0 (ต้องสร้างจาก Google Cloud Console ดู docs/GOOGLE_OAUTH_SETUP.md) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# อีเมลที่จะได้สิทธิ์ Admin อัตโนมัติเมื่อ login (คั่นด้วย , )
ADMIN_EMAILS=admin@example.com

# ---- การชำระเงิน ----
# test = ระบบจำลอง (ไม่มีเงินจริง, มีป้าย TEST MODE ชัดเจน) | live = ใช้ Gateway จริง (Opn Payments)
PAYMENT_MODE=test
# ระยะเวลาหมดอายุของคำสั่งซื้อ (นาที)
PAYMENT_EXPIRY_MINUTES=30
# คีย์สำหรับตรวจสอบลายเซ็น Webhook ของระบบโหมดทดสอบ
TEST_WEBHOOK_SECRET=change_me_test_webhook_secret

# ---- Opn Payments (ใช้เมื่อ PAYMENT_MODE=live ดู docs/PAYMENT_GATEWAY_SETUP.md) ----
OPN_SECRET_KEY=
OPN_PUBLIC_KEY=
OPN_WEBHOOK_SECRET=
OPN_API_BASE=https://api.opnpayments.com
# เปิดชำระด้วยบัตรเครดิต (ต้องตั้งค่า Opn.js ฝั่ง Frontend ตามเอกสาร)
OPN_CARD_ENABLED=false

# ---- การดาวน์โหลด ----
# อายุ Signed Download URL (วินาที)
DOWNLOAD_URL_TTL_SECONDS=300
# นโยบายหลังคืนเงิน: true = ถอนสิทธิ์ดาวน์โหลด, false = เก็บสิทธิ์เดิม
REVOKE_DOWNLOADS_ON_REFUND=true
# เปิดระบบรีวิวสินค้า
REVIEW_ENABLED=true
